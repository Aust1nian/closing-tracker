# Signed builds for TestFlight. Runs on the GitHub macOS runner (.github/workflows/ios.yml).
# Signing is Xcode's automatic signing through the App Store Connect API key,
# so no certificates or profiles live in the repo or in secrets.
default_platform(:ios)

platform :ios do
  desc "Archive, sign through the API key, upload to TestFlight"
  lane :beta do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    key_path = File.expand_path("~/private_keys/AuthKey_#{key_id}.p8")
    auth = "-allowProvisioningUpdates -authenticationKeyPath #{key_path} " \
           "-authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}"

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: team_id,
      xcargs: "#{auth} DEVELOPMENT_TEAM=#{team_id}",
      export_xcargs: auth,
      skip_profile_detection: true,
      output_directory: "build",
      output_name: "ClosingTracker.ipa",
    )

    upload_to_testflight(
      api_key: app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: key_path),
      ipa: "build/ClosingTracker.ipa",
      skip_waiting_for_build_processing: true,
    )
  end
end
